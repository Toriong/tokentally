{
  "name": "tokentally",
  "version": "1.0.0",
  "description": "Google Docs add-on for LLM token counting",
  "main": "build/Code.js",
  "scripts": {
    "build": "tsc && npm run bundle-tokenizer",
    "bundle-tokenizer": "node scripts/bundle-tokenizer.js",
    "copy-html": "cp src/*.html build/",
    "watch": "tsc --watch",
    "push": "npm run build && npx clasp push",
    "deploy": "npm run build && npx clasp push && npx clasp deploy",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "google-docs",
    "apps-script",
    "tokens",
    "llm"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@google/clasp": "^2.4.2",
    "@types/google-apps-script": "^1.0.83",
    "canvas": "^3.2.3",
    "esbuild": "^0.28.2",
    "js-tiktoken": "^1.0.21",
    "puppeteer": "^25.16.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  }
}
